{
  "@context": {
    "@vocab": "https://ramani.bv/bok/concepts/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "prov": "http://www.w3.org/ns/prov#",
    "dcterms": "http://purl.org/dc/terms/",
    "vm0047": "https://verra.org/methodology/vm0047#",
    "ofp": "https://openforestprotocol.org/vocab#",
    "gs": "https://goldstandard.org/vocab#",
    "prefLabel": "skos:prefLabel",
    "definition": "skos:definition",
    "exactMatch": "skos:exactMatch",
    "closeMatch": "skos:closeMatch"
  },
  "@type": "prov:Bundle",
  "dcterms:title": "DPB Outputs \u2014 Semantic Uplift",
  "dcterms:creator": "Collins Edem Hlordzie",
  "dcterms:date": "2026-06-09",
  "dcterms:subject": "Nature-based Carbon Removal / ARR / DPB",
  "dcterms:publisher": "RAMANI B.V.",
  "area": "Bono and Bono East, Ghana",
  "period": "2017-2023",
  "n_project_farms": 3672,
  "n_donor_farms": 2082,
  "prov:wasAttributedTo": {
    "@type": "prov:Agent",
    "name": "RAMANI B.V.",
    "supervisor": "Valentijn Venus"
  },
  "outputs": [
    {
      "@type": "skos:Concept",
      "@id": "https://ramani.bv/bok/concepts/stocking_index",
      "prefLabel": "Stocking Index (NDFI)",
      "definition": "Spectral proxy for vegetation density and woody biomass.",
      "value": "NDFI",
      "unit": "dimensionless index [-1, 1]",
      "method": "(NIR - SWIR1) / (NIR + SWIR1), Landsat 8 Band 5 and Band 6",
      "date": "2026-06-09",
      "standards": {
        "VM0047": {
          "uri": "https://verra.org/methodology/vm0047#StockingIndex",
          "term": "Stocking Index",
          "match": "exact"
        },
        "OFP": {
          "uri": "https://openforestprotocol.org/vocab#VegetationIndex",
          "term": "Vegetation Index",
          "match": "close"
        },
        "GoldStandard": {
          "uri": "https://goldstandard.org/vocab#VegetationCoverProxy",
          "term": "Vegetation Cover Proxy",
          "match": "close"
        }
      },
      "sensor": "Landsat 8 Collection 2 SR",
      "period": "2017-2023",
      "compositing": "annual cloud-free median"
    },
    {
      "@type": "skos:Concept",
      "@id": "https://ramani.bv/bok/concepts/donor_pool",
      "prefLabel": "Donor Pool",
      "definition": "Candidate control plots from unmanaged surrounding landscape.",
      "value": 2082,
      "unit": "farms",
      "method": "High-deforestation farms from RAMANI GeoJSON \u2014 All_Farms file",
      "date": "2026-06-09",
      "standards": {
        "VM0047": {
          "uri": "https://verra.org/methodology/vm0047#DonorPool",
          "term": "Donor Pool",
          "match": "exact"
        },
        "OFP": {
          "uri": "https://openforestprotocol.org/vocab#ReferenceAreaPool",
          "term": "Reference Area Pool",
          "match": "close"
        },
        "GoldStandard": {
          "uri": "https://goldstandard.org/vocab#BaselineReferencePool",
          "term": "Baseline Reference Pool",
          "match": "close"
        }
      },
      "n_project_farms": 3672,
      "k": 3
    },
    {
      "@type": "skos:Concept",
      "@id": "https://ramani.bv/bok/concepts/categorical_filter",
      "prefLabel": "Categorical Covariate Filter",
      "definition": "Pre-matching filter on ecoregion and land tenure.",
      "value": "region match + latitude band fallback (\u00b10.2\u00b0)",
      "unit": "categorical",
      "method": "Exact region match from survey join; lat-band proxy where survey unavailable",
      "date": "2026-06-09",
      "standards": {
        "VM0047": {
          "uri": "https://verra.org/methodology/vm0047#CategoricalVariables",
          "term": "Categorical Variables",
          "match": "exact"
        },
        "OFP": {
          "uri": "https://openforestprotocol.org/vocab#StratificationVariables",
          "term": "Stratification Variables",
          "match": "exact"
        },
        "GoldStandard": {
          "uri": "https://goldstandard.org/vocab#BaselineStratificationCriteria",
          "term": "Baseline Stratification Criteria",
          "match": "exact"
        }
      },
      "primary_filter": "region",
      "fallback_filter": "latitude band \u00b10.2\u00b0"
    },
    {
      "@type": "skos:Concept",
      "@id": "https://ramani.bv/bok/concepts/knn_matching",
      "prefLabel": "k-NN Matching",
      "definition": "k=3 nearest neighbours on location. NDFI excluded.",
      "value": 3672,
      "unit": "project farms matched",
      "method": "sklearn NearestNeighbors k=3, Euclidean on standardised (lon, lat)",
      "date": "2026-06-09",
      "standards": {
        "VM0047": {
          "uri": "https://verra.org/methodology/vm0047#MultivariateMatching",
          "term": "Multivariate Matching",
          "match": "exact"
        },
        "OFP": {
          "uri": "https://openforestprotocol.org/vocab#PlotMatching",
          "term": "Plot Matching",
          "match": "close"
        },
        "GoldStandard": {
          "uri": "https://goldstandard.org/vocab#ComparativeSiteAnalysis",
          "term": "Comparative Site Analysis",
          "match": "close"
        }
      },
      "k": 3,
      "matching_variables": [
        "longitude",
        "latitude"
      ],
      "excluded": "NDFI \u2014 excluded to preserve additionality signal"
    },
    {
      "@type": "skos:Concept",
      "@id": "https://ramani.bv/bok/concepts/performance_benchmark",
      "prefLabel": "Performance Benchmark (PB)",
      "definition": "Difference in stocking index between project plots and matched control plots.",
      "value": 0.00378,
      "unit": "NDFI index units",
      "method": "mean(project NDFI) - mean(matched control NDFI) per farm, then overall mean",
      "date": "2026-06-09",
      "standards": {
        "VM0047": {
          "uri": "https://verra.org/methodology/vm0047#PerformanceBenchmark",
          "term": "Performance Benchmark",
          "match": "exact"
        },
        "OFP": {
          "uri": "https://openforestprotocol.org/vocab#ProjectVsBaselinePerformance",
          "term": "Project vs Baseline Performance",
          "match": "close"
        },
        "GoldStandard": {
          "uri": "https://goldstandard.org/vocab#AdditionalityIndicator",
          "term": "Additionality Performance Indicator",
          "match": "close"
        }
      },
      "years_pb_positive": 6,
      "years_total": 7,
      "n_farms": 3672,
      "note": "NDFI proxy units only \u2014 tCO2e conversion requires field calibration"
    },
    {
      "@type": "skos:Concept",
      "@id": "https://ramani.bv/bok/concepts/confidence_interval",
      "prefLabel": "90% Confidence Interval",
      "definition": "Bootstrap 90% CI. Required at VM0047 Tier 2.",
      "value": 0.00378,
      "unit": "NDFI index units",
      "method": "Bootstrap resampling n=1000, 90% CI on annual PB means",
      "date": "2026-06-09",
      "standards": {
        "VM0047": {
          "uri": "https://verra.org/methodology/vm0047#ConfidenceInterval",
          "term": "90% CI (Tier 2)",
          "match": "exact"
        },
        "OFP": {
          "uri": "https://openforestprotocol.org/vocab#ConfidenceInterval",
          "term": "90% CI",
          "match": "exact"
        },
        "GoldStandard": {
          "uri": "https://goldstandard.org/vocab#ConfidenceInterval",
          "term": "90% CI",
          "match": "exact"
        }
      },
      "ci_lower": 0.001246,
      "ci_upper": 0.005662,
      "ci_level": 0.9,
      "n_bootstrap": 1000,
      "ci_above_zero": true
    },
    {
      "@type": "skos:Concept",
      "@id": "https://ramani.bv/bok/concepts/balance_check",
      "prefLabel": "Balance Check",
      "definition": "Standardised difference of means < 0.25.",
      "value": "passed",
      "unit": "standardised difference of means",
      "method": "Rosenbaum & Rubin (1985) \u2014 threshold 0.25",
      "date": "2026-06-09",
      "standards": {
        "VM0047": {
          "uri": "https://verra.org/methodology/vm0047#StandardisedDifference",
          "term": "Std diff < 0.25",
          "match": "exact"
        },
        "OFP": {
          "uri": "https://openforestprotocol.org/vocab#CovariateBalanceAssessment",
          "term": "Covariate Balance Assessment",
          "match": "close"
        },
        "GoldStandard": {
          "uri": "https://goldstandard.org/vocab#BaselineComparabilityCheck",
          "term": "Baseline Comparability Check",
          "match": "close"
        }
      },
      "threshold": 0.25,
      "years_passed": 7,
      "years_total": 7
    },
    {
      "@type": "skos:Concept",
      "@id": "https://ramani.bv/bok/concepts/additionality",
      "prefLabel": "Additionality",
      "definition": "PB > 0 with CI entirely above zero.",
      "value": "CONFIRMED",
      "unit": "",
      "method": "PB > 0 AND 90% CI entirely above zero across 7-year monitoring period",
      "date": "2026-06-09",
      "standards": {
        "VM0047": {
          "uri": "https://verra.org/methodology/vm0047#Additionality",
          "term": "Additionality (DPB)",
          "match": "close"
        },
        "OFP": {
          "uri": "https://openforestprotocol.org/vocab#Additionality",
          "term": "Additionality (counterfactual rate)",
          "match": "close"
        },
        "GoldStandard": {
          "uri": "https://goldstandard.org/vocab#Additionality",
          "term": "Additionality (CDM tool)",
          "match": "close"
        }
      },
      "pb_positive": true,
      "ci_above_zero": true,
      "years_confirmed": 6,
      "years_total": 7
    },
    {
      "@type": "skos:Concept",
      "@id": "https://ramani.bv/bok/concepts/dynamic_baseline",
      "prefLabel": "Dynamic Baseline",
      "definition": "Annually updated baseline from satellite obs. VM0047-specific.",
      "value": "Annual Landsat 8 NDFI composite",
      "unit": "NDFI per year",
      "method": "GEE annual median composite of matched donor pool plots",
      "date": "2026-06-09",
      "standards": {
        "VM0047": {
          "uri": "https://verra.org/methodology/vm0047#DynamicBaseline",
          "term": "Dynamic Performance Baseline",
          "match": "exact"
        },
        "OFP": {
          "uri": null,
          "term": "No equivalent (uses static historical baseline)",
          "match": "none"
        },
        "GoldStandard": {
          "uri": null,
          "term": "No equivalent (uses static modelled baseline)",
          "match": "none"
        }
      },
      "reference_year": 2000,
      "monitoring_start": 2017,
      "monitoring_end": 2023,
      "note": "Forest_2000_ha field anchors carbon stock to year-2000 Hansen baseline"
    }
  ],
